# 키 값은 커밋하지 말고 .env 에만 넣는다.
SEOUL_OPEN_API_KEY=
# 공공데이터포털(data.go.kr) 일반 인증키 (Decoding) — 에어코리아 미세먼지 예보 등
DATA_GO_KR_API_KEY=
# 서울시 도시데이터 장소 코드 — 올림픽공원은 POI127 (2026-11-23 실호출로 확인)
SEOUL_CITYDATA_AREA=POI127
# 프론트엔드에서 백엔드 주소 (기본: Vite 프록시로 /api 사용)
VITE_API_BASE_URL=
# 문화공공데이터광장(culture.go.kr) — 한국체육산업개발 데이터. API마다 키가 따로 나옴, 호출 한도 5초에 1회
# 올림픽공원 2025 연계 데이터(시간대별 공연명·관람객 수) — 집계 파일 재생성 시에만 필요
CULTURE_API_KEY=
# 올림픽공원 2025 입출차정보(차량별 입·출차 기록) — 분석 스크립트용
CULTURE_ENTRY_API_KEY=
# KOPIS 공연예술통합전산망(kopis.or.kr) — 오늘 올림픽공원 공연 일정. 1인 1키, 양도·공유 금지 → 각자 발급
KOPIS_API_KEY=
